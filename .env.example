# Copy to .env for Docker Compose; generate a unique key before startup.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PUBLIC_URL=http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
POSTGRES_DB=booktracker
POSTGRES_USER=booktracker
POSTGRES_PASSWORD=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=mailpit
DJANGO_EMAIL_PORT=1025
DJANGO_DEFAULT_FROM_EMAIL=Booktracker <noreply@example.com>
